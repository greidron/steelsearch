  "cases": [
    {
      "name": "register_snapshot_repository",
      "method": "PUT",
      "path": "/_snapshot/repo-compat",
      "body": {
        "type": "fs",
        "settings": {
          "location": "${SNAPSHOT_REPOSITORY_BASE_DIR}/steelsearch-snapshot-compat",
          "compress": true,
          "readonly": false,
          "chunk_size": "32m"
        }
      },
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "acknowledged"
        ],
        "body_paths_equal": [
          "acknowledged"
        ]
      }
    },
    {
      "name": "delete_existing_snapshot_clone_subset_after_repository_registration",
      "method": "DELETE",
      "path": "/_snapshot/repo-compat/snapshot-clone-source"
    },
    {
      "name": "delete_existing_snapshot_clone_target_after_repository_registration",
      "method": "DELETE",
      "path": "/_snapshot/repo-compat/snapshot-clone-a-only"
