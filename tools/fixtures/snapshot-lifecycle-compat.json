          "recovered-restore-ds-*"
        ],
        "data_stream": {},
        "template": {
          "settings": {
            "index": {
              "number_of_replicas": 0
            }
          }
        }
      }
    },
    {
      "name": "create_restore_data_stream",
      "method": "PUT",
      "path": "/_data_stream/logs-restore-ds-prod"
    },
    {
      "name": "seed_restore_data_stream_doc",
      "method": "POST",
      "path": "/logs-restore-ds-prod/_doc/doc-1?op_type=create&refresh=true",
      "body": {
        "@timestamp": "2026-08-30T00:00:00Z",
        "message": "snapshot data stream compat seed"
      }
    },
    {
      "name": "create_logs_compat_index",
      "method": "PUT",
      "path": "/logs-compat",
      "body": {
        "settings": {
          "index": {
            "number_of_shards": 1,
            "number_of_replicas": 0,
            "refresh_interval": "1s",
            "priority": 10
          }
        }
      }
    },
    {
      "name": "seed_logs_compat_doc",
      "method": "PUT",
