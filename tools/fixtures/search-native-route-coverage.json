      "family": "single-index-text-size-zero",
      "method": "POST",
      "path": "/comparison-logs/_search",
      "body": {
      "query": {
        "wildcard": {
          "message": {
            "value": "*PAYMENT*"
          }
        }
      },
      "aggs": {
        "by_service": {
          "terms": {
            "field": "service",
            "size": 10
          }
        }
      },
      "size": 0,
      "profile": true
      },
      "extract": "search_hits",
      "comparison": "steelsearch_only",
      "native_route_group": "single_index_text_case_insensitive_wildcard_size_zero",
      "expected_steelsearch_status": 200,
      "skip_scope": "native-route-steelsearch-observation",
      "reason": "Steelsearch-only native route observation case; OpenSearch-visible parity is covered by the separate search compatibility suite."
    },
