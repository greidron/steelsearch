{
  "name": "root-cluster-node-compat",
  "setup": [
    {
      "name": "create_logs_cat_compat_index",
      "method": "PUT",
      "path": "/logs-cat-compat",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "acknowledged",
          "index"
        ]
      }
    },
    {
      "name": "open_logs_cat_compat_pit",
      "method": "POST",
      "path": "/logs-cat-compat/_search/point_in_time?keep_alive=1m",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "pit_id"
        ]
      }
    }
  ],
  "cases": [
    {
      "name": "get_root_identity_shape",
      "method": "GET",
      "path": "/",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "name",
          "cluster_name",
          "cluster_uuid",
          "version",
          "tagline"
        ],
        "body_exact": {
          "tagline": "The OpenSearch Project: https://opensearch.org/"
        },
        "body_paths_equal": [
          "tagline"
        ]
      }
    },
    {
      "name": "head_root_liveness",
      "method": "HEAD",
      "path": "/",
      "compare": {
        "expected_status": 200,
        "expected_body_text": ""
      }
    },
    {
      "name": "get_cat_indices_json_shape",
      "method": "GET",
      "path": "/_cat/indices?format=json",
      "compare": {
        "expected_status": 200,
        "compare_mode": "cat_indices_json"
      }
    },
    {
      "name": "get_cat_indices_text_shape",
      "method": "GET",
      "path": "/_cat/indices?v=true",
      "compare": {
        "expected_status": 200,
        "body_text_contains": [
          "health status index",
          "logs-cat-compat"
        ]
      }
    },
    {
      "name": "get_cat_plugins_json_shape",
      "method": "GET",
      "path": "/_cat/plugins?format=json",
      "compare": {
        "expected_status": 200,
        "compare_mode": "cat_plugins_json"
      }
    },
    {
      "name": "get_cat_plugins_text_shape",
      "method": "GET",
      "path": "/_cat/plugins?v=true",
      "compare": {
        "expected_status": 200,
        "body_text_contains": [
          "name component version"
        ]
      }
    },
    {
      "name": "get_nodes_info_metric_shorthand_http_only",
      "method": "GET",
      "path": "/_nodes/http",
      "compare": {
        "expected_status": 200,
        "compare_mode": "nodes_info_http_only"
      }
    },
    {
      "name": "get_nodes_info_ignores_unknown_metric",
      "method": "GET",
      "path": "/_nodes/_all/http,bogus",
      "compare": {
        "expected_status": 200,
        "compare_mode": "nodes_info_http_only"
      }
    },
    {
      "name": "get_nodes_usage_rest_actions_only",
      "method": "GET",
      "path": "/_nodes/usage/rest_actions",
      "compare": {
        "expected_status": 200,
        "compare_mode": "nodes_usage_rest_actions_only"
      }
    },
    {
      "name": "get_cat_pit_segments_all_text_shape",
      "method": "GET",
      "path": "/_cat/pit_segments/_all?v=true",
      "compare": {
        "expected_status": 200,
        "body_text_contains": [
          "index shard prirep ip segment generation docs.count docs.deleted size size.memory committed searchable version compound"
        ]
      }
    }
  ]
}
