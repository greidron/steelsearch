{
  "name": "multi-node-transport-admin",
  "cases": [
    {
      "name": "node_a_cluster_health",
      "target": "node_a",
      "method": "GET",
      "path": "/_cluster/health",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "status",
          "number_of_nodes",
          "number_of_data_nodes",
          "timed_out"
        ],
        "body_paths_equal": {
          "status": "green",
          "number_of_nodes": 2,
          "number_of_data_nodes": 2,
          "timed_out": false
        }
      }
    },
    {
      "name": "node_b_cluster_state",
      "target": "node_b",
      "method": "GET",
      "path": "/_cluster/state",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "cluster_name",
          "metadata",
          "master_node",
          "state_uuid",
          "version"
        ],
        "body_paths_equal": {
          "cluster_name": "steelsearch-dev",
          "metadata.cluster_uuid": "steelsearch-dev-cluster-uuid",
          "state_uuid": "steelsearch-state-uuid",
          "version": 1
        },
        "body_object_key_counts": {
          "nodes": 2
        }
      }
    },
    {
      "name": "node_a_cluster_settings",
      "target": "node_a",
      "method": "GET",
      "path": "/_cluster/settings",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "persistent",
          "transient"
        ],
        "body_paths_equal": {
          "persistent": {},
          "transient": {}
        }
      }
    },
    {
      "name": "node_b_pending_tasks",
      "target": "node_b",
      "method": "GET",
      "path": "/_cluster/pending_tasks",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "tasks"
        ],
        "body_array_lengths": {
          "tasks": 0
        }
      }
    },
    {
      "name": "node_a_tasks",
      "target": "node_a",
      "method": "GET",
      "path": "/_tasks",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "nodes"
        ],
        "body_object_key_counts": {
          "nodes": 1
        },
        "body_paths_equal": {
          "nodes.steel-node-1.name": "steel-node-1"
        }
      }
    },
    {
      "name": "node_b_nodes_stats",
      "target": "node_b",
      "method": "GET",
      "path": "/_nodes/stats",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "nodes"
        ],
        "body_object_key_counts": {
          "nodes": 2
        },
        "body_paths_equal": {
          "nodes.steel-node-2.indices.docs.count": 0
        }
      }
    },
    {
      "name": "node_a_cluster_stats",
      "target": "node_a",
      "method": "GET",
      "path": "/_cluster/stats",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "indices",
          "nodes"
        ],
        "body_paths_equal": {
          "status": "green",
          "nodes.count.total": 2,
          "nodes.count.data": 2,
          "indices.count": 0
        }
      }
    },
    {
      "name": "node_b_indices_stats",
      "target": "node_b",
      "method": "GET",
      "path": "/_stats",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "_all",
          "indices"
        ],
        "body_paths_equal": {
          "_shards.total": 0,
          "_shards.successful": 0,
          "_shards.failed": 0,
          "_all.total.docs.count": 0
        }
      }
    },
    {
      "name": "node_a_create_pit_index",
      "target": "node_a",
      "method": "PUT",
      "path": "/multi-node-pit-000001",
      "body": {
        "settings": {
          "index": {
            "number_of_shards": 1,
            "number_of_replicas": 0
          }
        }
      },
      "compare": {
        "expected_status": 200,
        "body_paths_equal": {
          "acknowledged": true
        }
      }
    },
    {
      "name": "node_a_write_pit_document",
      "target": "node_a",
      "method": "PUT",
      "path": "/multi-node-pit-000001/_doc/doc-1?refresh=true",
      "body": {
        "message": "visible-through-pit"
      },
      "compare": {
        "expected_status": 201,
        "body_paths_equal": {
          "_index": "multi-node-pit-000001",
          "_id": "doc-1",
          "result": "created"
        }
      }
    },
    {
      "name": "node_a_open_pit",
      "target": "node_a",
      "method": "POST",
      "path": "/multi-node-pit-000001/_search/point_in_time?keep_alive=1m",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "pit_id",
          "creation_time",
          "_shards.total"
        ],
        "body_paths_equal": {
          "_shards.failed": 0
        }
      }
    },
    {
      "name": "node_b_search_node_a_pit",
      "target": "node_b",
      "method": "POST",
      "path": "/_search",
      "body": {
        "pit": {
          "id": "${node_a_open_pit.response.body.pit_id}",
          "keep_alive": "1m"
        },
        "query": {
          "match_all": {}
        }
      },
      "compare": {
        "expected_status": 200,
        "body_paths_equal": {
          "hits.total.value": 1,
          "hits.hits.0._id": "doc-1",
          "hits.hits.0._source.message": "visible-through-pit"
        }
      }
    },
    {
      "name": "node_b_close_node_a_pit",
      "target": "node_b",
      "method": "DELETE",
      "path": "/_search/point_in_time",
      "body": {
        "pit_id": "${node_a_open_pit.response.body.pit_id}"
      },
      "compare": {
        "expected_status": 200,
        "body_paths_equal": {
          "pits.0.successful": true
        }
      }
    },
    {
      "name": "node_b_search_node_a_pit_after_close",
      "target": "node_b",
      "method": "POST",
      "path": "/_search",
      "body": {
        "pit": {
          "id": "${node_a_open_pit.response.body.pit_id}",
          "keep_alive": "1m"
        },
        "query": {
          "match_all": {}
        }
      },
      "compare": {
        "expected_status": 404,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ],
        "body_paths_equal": {
          "status": 404
        }
      }
    },
    {
      "name": "node_a_list_pits_after_node_b_close",
      "target": "node_a",
      "method": "GET",
      "path": "/_search/point_in_time/_all",
      "compare": {
        "expected_status": 200,
        "body_array_lengths": {
          "pits": 0
        }
      }
    }
  ],
  "post_checks": [
    {
      "name": "cluster_name_consistent_between_health_and_state",
      "left": {
        "case": "node_a_cluster_health",
        "path": "response.body.cluster_name"
      },
      "right": {
        "case": "node_b_cluster_state",
        "path": "response.body.cluster_name"
      }
    },
    {
      "name": "cluster_name_consistent_between_health_and_stats",
      "left": {
        "case": "node_a_cluster_health",
        "path": "response.body.cluster_name"
      },
      "right": {
        "case": "node_a_cluster_stats",
        "path": "response.body.cluster_name"
      }
    },
    {
      "name": "node_count_matches_cluster_state_nodes",
      "left": {
        "case": "node_a_cluster_health",
        "path": "response.body.number_of_nodes"
      },
      "right": {
        "case": "node_b_cluster_state",
        "path": "response.body.nodes",
        "transform": "len"
      }
    },
    {
      "name": "node_count_matches_nodes_stats_nodes",
      "left": {
        "case": "node_a_cluster_health",
        "path": "response.body.number_of_nodes"
      },
      "right": {
        "case": "node_b_nodes_stats",
        "path": "response.body.nodes",
        "transform": "len"
      }
    },
    {
      "name": "cluster_uuid_matches_metadata_cluster_uuid",
      "left": {
        "case": "node_b_cluster_state",
        "path": "response.body.cluster_uuid"
      },
      "right": {
        "case": "node_b_cluster_state",
        "path": "response.body.metadata.cluster_uuid"
      }
    }
  ]
}
