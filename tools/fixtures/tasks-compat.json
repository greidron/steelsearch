{
  "name": "tasks-compat",
  "cases": [
    {
      "name": "get_cluster_pending_tasks_shape",
      "method": "GET",
      "path": "/_cluster/pending_tasks",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "tasks"
        ],
        "compare_mode": "pending_tasks_shape"
      }
    },
    {
      "name": "get_tasks_list_shape",
      "method": "GET",
      "path": "/_tasks",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "nodes"
        ],
        "compare_mode": "tasks_list_shape"
      }
    },
    {
      "name": "get_tasks_list_group_by_parents_shape",
      "method": "GET",
      "path": "/_tasks?group_by=parents",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "tasks"
        ],
        "compare_mode": "tasks_parents_shape"
      }
    },
    {
      "name": "get_tasks_list_group_by_none_shape",
      "method": "GET",
      "path": "/_tasks?group_by=none",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "tasks"
        ],
        "compare_mode": "tasks_flat_shape"
      }
    },
    {
      "name": "reject_tasks_list_invalid_group_by",
      "method": "GET",
      "path": "/_tasks?group_by=bogus",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "error.root_cause",
          "error.root_cause.0.type",
          "error.root_cause.0.reason",
          "status"
        ],
        "body_paths_equal": [
          "error.type",
          "error.reason",
          "error.root_cause.0.type",
          "error.root_cause.0.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_tasks_list_invalid_detailed_boolean",
      "method": "GET",
      "path": "/_tasks?detailed=maybe",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "error.root_cause",
          "error.root_cause.0.type",
          "error.root_cause.0.reason",
          "status"
        ],
        "body_paths_equal": [
          "error.type",
          "error.reason",
          "error.root_cause.0.type",
          "error.root_cause.0.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_tasks_list_invalid_timeout",
      "method": "GET",
      "path": "/_tasks?timeout=soon",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "error.root_cause",
          "error.root_cause.0.type",
          "error.root_cause.0.reason",
          "status"
        ],
        "body_paths_equal": [
          "error.type",
          "error.reason",
          "error.root_cause.0.type",
          "error.root_cause.0.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_tasks_get_invalid_wait_for_completion_boolean",
      "method": "GET",
      "path": "/_tasks/node-a:999?wait_for_completion=maybe",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_tasks_get_invalid_timeout",
      "method": "GET",
      "path": "/_tasks/node-a:999?timeout=soon",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_cluster_pending_tasks_invalid_local_boolean",
      "method": "GET",
      "path": "/_cluster/pending_tasks?local=maybe",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_cluster_pending_tasks_invalid_timeout",
      "method": "GET",
      "path": "/_cluster/pending_tasks?cluster_manager_timeout=soon",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_unknown_task_cancel_shape",
      "method": "POST",
      "path": "/_tasks/_cancel?task_id=node-a:999",
      "compare": {
        "expected_status": 200,
        "body_paths_present": [
          "nodes",
          "node_failures"
        ],
        "body_paths_equal": []
      }
    },
    {
      "name": "reject_tasks_cancel_invalid_group_by",
      "method": "POST",
      "path": "/_tasks/_cancel?task_id=node-a:999&group_by=bogus",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ]
      }
    },
    {
      "name": "reject_tasks_cancel_invalid_wait_for_completion_boolean",
      "method": "POST",
      "path": "/_tasks/_cancel?wait_for_completion=maybe",
      "compare": {
        "expected_status": 400,
        "body_paths_present": [
          "error.type",
          "error.reason",
          "status"
        ]
      }
    }
  ]
}
