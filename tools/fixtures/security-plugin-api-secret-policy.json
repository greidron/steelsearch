{
  "name": "security-plugin-api-secret-policy",
  "profile": "multi-node-secure",
  "cases": [
    {
      "case": "account_api_reader_allowed",
      "route": "/_plugins/_security/api/account",
      "method": "GET",
      "credential_set": "reader-basic",
      "expected_result": "allowed",
      "expected_status": 200,
      "secret_redaction_markers": [
        "password=[REDACTED]",
        "Authorization=[REDACTED]"
      ]
    },
    {
      "case": "internalusers_api_writer_denied",
      "route": "/_plugins/_security/api/internalusers",
      "method": "GET",
      "credential_set": "writer-basic",
      "expected_result": "denied",
      "expected_status": 403,
      "secret_redaction_markers": [
        "password=[REDACTED]",
        "Authorization=[REDACTED]"
      ]
    },
    {
      "case": "roles_api_admin_allowed",
      "route": "/_plugins/_security/api/roles",
      "method": "GET",
      "credential_set": "admin-basic",
      "expected_result": "allowed",
      "expected_status": 200,
      "secret_redaction_markers": [
        "password=[REDACTED]",
        "Authorization=[REDACTED]"
      ]
    },
    {
      "case": "rolesmapping_api_writer_denied",
      "route": "/_plugins/_security/api/rolesmapping",
      "method": "PUT",
      "credential_set": "writer-basic",
      "expected_result": "denied",
      "expected_status": 403,
      "secret_redaction_markers": [
        "password=[REDACTED]",
        "Authorization=[REDACTED]"
      ]
    },
    {
      "case": "sslcerts_api_admin_allowed",
      "route": "/_plugins/_security/api/ssl/certs",
      "method": "GET",
      "credential_set": "admin-basic",
      "expected_result": "allowed",
      "expected_status": 200,
      "secret_redaction_markers": [
        "password=[REDACTED]",
        "private_key=[REDACTED]"
      ]
    }
  ]
}
