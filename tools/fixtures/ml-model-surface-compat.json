{
  "name": "ml-model-surface-compat",
  "aggregate_case": {
    "name": "ml_model_lifecycle_shape",
    "reason": "Aggregate lifecycle marker passes when all required ML Commons/neural-search fixture cases pass on both Steelsearch and OpenSearch.",
    "required_cases": [
      "register_model_group",
      "get_model_group",
      "register_model",
      "get_register_task",
      "create_connector",
      "get_connector",
      "get_model",
      "deploy_model",
      "get_deploy_task",
      "predict_model",
      "search_model",
      "neural_query_search",
      "put_rerank_pipeline",
      "rerank_pipeline_search",
      "neural_sparse_raw_search",
      "undeploy_model"
    ],
    "metadata": {
      "evidence_classes": [
        "model-group-lifecycle",
        "task-lifecycle",
        "connector-lifecycle",
        "deploy-persistence",
        "neural-query-rewrite",
        "rerank-pipeline",
        "neural-sparse-raw"
      ]
    }
  },
  "cases": [
    {
      "name": "register_model_group",
      "method": "POST",
      "path": "/_plugins/_ml/model_groups/_register",
      "body": {
        "name": "compat embeddings ${run.id}",
        "description": "compat model group"
      },
      "expected_status": 200,
      "compare_paths": [
        "status"
      ],
      "expected_paths": {
        "status": "CREATED"
      },
      "metadata": {
        "evidence_classes": [
          "model-group-lifecycle"
        ]
      }
    },
    {
      "name": "get_model_group",
      "method": "GET",
      "path": "/_plugins/_ml/model_groups/${register_model_group.model_group_id}",
      "expected_status": 200,
      "compare_paths": [
        "name",
        "description"
      ],
      "expected_paths": {
        "name": "compat embeddings ${run.id}",
        "description": "compat model group"
      },
      "metadata": {
        "evidence_classes": [
          "model-group-lifecycle"
        ]
      }
    },
    {
      "name": "register_model",
      "method": "POST",
      "path": "/_plugins/_ml/models/_register",
      "body": {
        "name": "huggingface/sentence-transformers/all-MiniLM-L6-v2",
        "version": "1.0.1",
        "model_format": "TORCH_SCRIPT"
      },
      "expected_status": 200,
      "compare_paths": [
        "status"
      ],
      "expected_paths": {
        "status": "CREATED"
      }
    },
    {
      "name": "get_register_task",
      "method": "GET",
      "path": "/_plugins/_ml/tasks/${register_model.task_id}",
      "expected_status": 200,
      "wait_attempts": 10,
      "wait_interval_seconds": 1,
      "compare_paths": [
        "task_type",
        "state"
      ],
      "expected_paths": {
        "task_type": "REGISTER_MODEL",
        "state": "COMPLETED"
      },
      "metadata": {
        "evidence_classes": [
          "task-lifecycle"
        ]
      }
    },
    {
      "name": "create_connector",
      "method": "POST",
      "path": "/_plugins/_ml/connectors/_create",
      "body": {
        "name": "compat-connector",
        "description": "compat connector fixture",
        "version": 1,
        "protocol": "http",
        "parameters": {
          "endpoint": "example.com",
          "model": "text-embedding-ada-002"
        },
        "credential": {
          "openAI_key": "steelsearch-fixture-secret"
        },
        "actions": [
          {
            "action_type": "predict",
            "method": "POST",
            "url": "https://${parameters.endpoint}/v1/embeddings",
            "headers": {
              "Authorization": "Bearer ${credential.openAI_key}"
            },
            "request_body": "{ \"input\": ${parameters.input}, \"model\": \"${parameters.model}\" }"
          }
        ]
      },
      "expected_status": 200,
      "compare_paths": [],
      "expected_paths": {},
      "metadata": {
        "evidence_classes": [
          "connector-lifecycle"
        ]
      }
    },
    {
      "name": "get_connector",
      "method": "GET",
      "path": "/_plugins/_ml/connectors/${create_connector.connector_id}",
      "expected_status": 200,
      "compare_paths": [
        "name",
        "protocol"
      ],
      "expected_paths": {
        "name": "compat-connector",
        "protocol": "http"
      },
      "metadata": {
        "evidence_classes": [
          "connector-lifecycle"
        ]
      }
    },
    {
      "name": "get_model",
      "method": "GET",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}",
      "expected_status": 200,
      "compare_paths": [
        "name",
        "model_format",
        "model_state"
      ],
      "expected_paths": {
        "name": "huggingface/sentence-transformers/all-MiniLM-L6-v2",
        "model_format": "TORCH_SCRIPT",
        "model_state": "REGISTERED"
      }
    },
    {
      "name": "deploy_model",
      "method": "POST",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}/_deploy",
      "expected_status": 200,
      "compare_paths": [
        "task_type",
        "status"
      ],
      "expected_paths": {
        "task_type": "DEPLOY_MODEL",
        "status": "CREATED"
      },
      "metadata": {
        "evidence_classes": [
          "task-lifecycle"
        ]
      }
    },
    {
      "name": "get_deploy_task",
      "method": "GET",
      "path": "/_plugins/_ml/tasks/${deploy_model.task_id}",
      "expected_status": 200,
      "wait_attempts": 30,
      "wait_interval_seconds": 1,
      "compare_paths": [
        "task_type",
        "state"
      ],
      "expected_paths": {
        "task_type": "DEPLOY_MODEL",
        "state": "COMPLETED"
      },
      "metadata": {
        "evidence_classes": [
          "task-lifecycle"
        ]
      }
    },
    {
      "name": "predict_model",
      "reason": "Compares successful ML predict route execution; exact embedding values are model-output data and are not used as stable parity keys.",
      "method": "POST",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}/_predict",
      "body": {
        "text_docs": [
          "alpha beta"
        ]
      },
      "expected_status": 200,
      "compare_paths": [],
      "expected_paths": {}
    },
    {
      "name": "search_model",
      "method": "POST",
      "path": "/_plugins/_ml/models/_search",
      "body": {
        "query": {
          "term": {
            "model_id": "${get_register_task.model_id}"
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "hits.total.value",
        "hits.hits.0._id"
      ],
      "expected_paths": {
        "hits.total.value": 10,
        "hits.hits.0._id": "${get_register_task.model_id}_0"
      }
    },
    {
      "name": "create_neural_index",
      "method": "PUT",
      "path": "/vectors-neural-compat",
      "body": {
        "settings": {
          "index.knn": true
        },
        "mappings": {
          "properties": {
            "title": {
              "type": "text"
            },
            "embedding": {
              "type": "knn_vector",
              "dimension": 384,
              "method": {
                "name": "hnsw",
                "engine": "lucene",
                "space_type": "l2"
              }
            }
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "acknowledged"
      ],
      "expected_paths": {
        "acknowledged": true
      }
    },
