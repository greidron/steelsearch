{
  "name": "ml-model-surface-compat",
  "aggregate_case": {
    "name": "ml_model_lifecycle_shape",
    "comparison": "steelsearch_only",
    "expected_steelsearch_status": 200,
    "skip_scope": "opensearch-ml-dev-target-lifecycle",
    "reason": "Aggregate Steelsearch lifecycle evidence remains Steelsearch-only until the OpenSearch ML Commons dev target completes connector, deploy, predict, rerank, sparse, and undeploy cases in the same lightweight fixture.",
    "required_cases": [
      "register_model_group",
      "get_model_group",
      "register_model",
      "get_register_task",
      "create_connector",
      "get_connector",
      "get_model",
      "deploy_model",
      "get_deploy_task",
      "predict_model",
      "search_model",
      "neural_query_search",
      "rerank_pipeline_search",
      "sparse_encoder_search",
      "undeploy_model"
    ],
    "metadata": {
      "evidence_classes": [
        "model-group-lifecycle",
        "task-lifecycle",
        "connector-lifecycle",
        "deploy-persistence",
        "neural-query-rewrite",
        "rerank-pipeline",
        "sparse-encoder"
      ]
    }
  },
  "cases": [
    {
      "name": "register_model_group",
      "method": "POST",
      "path": "/_plugins/_ml/model_groups/_register",
      "body": {
        "name": "compat embeddings ${run.id}",
        "description": "compat model group"
      },
      "expected_status": 200,
      "compare_paths": [
        "status"
      ],
      "expected_paths": {
        "status": "CREATED"
      },
      "metadata": {
        "evidence_classes": [
          "model-group-lifecycle"
        ]
      }
    },
    {
      "name": "get_model_group",
      "method": "GET",
      "path": "/_plugins/_ml/model_groups/${register_model_group.model_group_id}",
      "expected_status": 200,
      "compare_paths": [
        "name",
        "description"
      ],
      "expected_paths": {
        "name": "compat embeddings ${run.id}",
        "description": "compat model group"
      },
      "metadata": {
        "evidence_classes": [
          "model-group-lifecycle"
        ]
      }
    },
    {
      "name": "register_model",
      "method": "POST",
      "path": "/_plugins/_ml/models/_register",
      "body": {
        "name": "huggingface/sentence-transformers/all-MiniLM-L6-v2",
        "version": "1.0.1",
        "model_format": "TORCH_SCRIPT"
      },
      "expected_status": 200,
      "compare_paths": [
        "status"
      ],
      "expected_paths": {
        "status": "CREATED"
      }
    },
    {
      "name": "get_register_task",
      "method": "GET",
      "path": "/_plugins/_ml/tasks/${register_model.task_id}",
      "expected_status": 200,
      "wait_attempts": 10,
      "wait_interval_seconds": 1,
      "compare_paths": [
        "task_type",
        "state"
      ],
      "expected_paths": {
        "task_type": "REGISTER_MODEL",
        "state": "COMPLETED"
      },
      "metadata": {
        "evidence_classes": [
          "task-lifecycle"
        ]
      }
    },
    {
      "name": "create_connector",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-connector-fixture",
      "reason": "OpenSearch ML Commons rejects the lightweight connector payload used for Steelsearch connector lifecycle evidence; full OpenSearch connector parity needs a credential/action fixture.",
      "method": "POST",
      "path": "/_plugins/_ml/connectors/_create",
      "body": {
        "name": "compat-connector",
        "protocol": "http"
      },
      "expected_status": 200,
      "compare_paths": [
        "name",
        "protocol"
      ],
      "expected_paths": {
        "name": "compat-connector",
        "protocol": "http"
      },
      "metadata": {
        "evidence_classes": [
          "connector-lifecycle"
        ]
      }
    },
    {
      "name": "get_connector",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-connector-fixture",
      "reason": "Depends on the lightweight connector create case, which OpenSearch ML Commons rejects without a full credential/action connector fixture.",
      "method": "GET",
      "path": "/_plugins/_ml/connectors/${create_connector.connector_id}",
      "expected_status": 200,
      "compare_paths": [
        "connector_id",
        "name",
        "protocol"
      ],
      "expected_paths": {
        "connector_id": "${create_connector.connector_id}",
        "name": "compat-connector",
        "protocol": "http"
      },
      "metadata": {
        "evidence_classes": [
          "connector-lifecycle"
        ]
      }
    },
    {
      "name": "get_model",
      "method": "GET",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}",
      "expected_status": 200,
      "compare_paths": [
        "name",
        "model_format",
        "model_state"
      ],
      "expected_paths": {
        "name": "huggingface/sentence-transformers/all-MiniLM-L6-v2",
        "model_format": "TORCH_SCRIPT",
        "model_state": "REGISTERED"
      }
    },
    {
      "name": "deploy_model",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-dev-target-lifecycle",
      "reason": "OpenSearch ML Commons model deployment does not reach the compact deployed response shape in the constrained dev target; Steelsearch deployment lifecycle evidence remains explicit.",
      "method": "POST",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}/_deploy",
      "expected_status": 200,
      "compare_paths": [
        "model_id",
        "deployed",
        "task_state"
      ],
      "expected_paths": {
        "model_id": "${get_register_task.model_id}",
        "deployed": true,
        "task_state": "DEPLOYED"
      },
      "metadata": {
        "evidence_classes": [
          "task-lifecycle"
        ]
      }
    },
    {
      "name": "get_deploy_task",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-dev-target-lifecycle",
      "reason": "Depends on OpenSearch ML Commons deploy task completion, which is not stable in the constrained dev target.",
      "method": "GET",
      "path": "/_plugins/_ml/tasks/${deploy_model.task_id}",
      "expected_status": 200,
      "compare_paths": [
        "task_id",
        "model_id",
        "task_type",
        "state"
      ],
      "expected_paths": {
        "task_id": "${deploy_model.task_id}",
        "model_id": "${get_register_task.model_id}",
        "task_type": "DEPLOY_MODEL",
        "state": "COMPLETED"
      },
      "metadata": {
        "evidence_classes": [
          "task-lifecycle"
        ]
      }
    },
    {
      "name": "predict_model",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-dev-target-lifecycle",
      "reason": "Depends on a deployed OpenSearch ML Commons model; the constrained dev target does not provide stable serving output for this fixture.",
      "method": "POST",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}/_predict",
      "body": {
        "text_docs": [
          "alpha beta"
        ]
      },
      "expected_status": 200,
      "compare_paths": [
        "inference_results.0.model_id",
        "inference_results.0.output.0.0",
        "inference_results.0.output.0.1"
      ],
      "expected_paths": {
        "inference_results.0.model_id": "${get_register_task.model_id}",
        "inference_results.0.output.0.0": 10.0,
        "inference_results.0.output.0.1": 2.0
      }
    },
    {
      "name": "search_model",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-dev-target-lifecycle",
      "reason": "OpenSearch ML Commons model search emits implementation-specific chunk/model documents after registration and deployment attempts, so this Steelsearch lifecycle readback remains a Steelsearch-only evidence case.",
      "method": "POST",
      "path": "/_plugins/_ml/models/_search",
      "body": {
        "query": {
          "term": {
            "model_id": "${get_register_task.model_id}"
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "hits.total.value",
        "hits.hits.0._id",
        "hits.hits.0._source.deployed"
      ],
      "expected_paths": {
        "hits.total.value": 1,
        "hits.hits.0._id": "${get_register_task.model_id}",
        "hits.hits.0._source.deployed": true
      }
    },
    {
      "name": "create_neural_index",
      "method": "PUT",
      "path": "/vectors-neural-compat",
      "body": {
        "settings": {
          "index.knn": true
        },
        "mappings": {
          "properties": {
            "title": {
              "type": "text"
            },
            "embedding": {
              "type": "knn_vector",
              "dimension": 3,
              "method": {
                "name": "hnsw",
                "engine": "lucene",
                "space_type": "l2"
              }
            }
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "acknowledged"
      ],
      "expected_paths": {
        "acknowledged": true
      }
    },
    {
      "name": "put_neural_doc_a",
      "method": "PUT",
      "path": "/vectors-neural-compat/_doc/doc-a?refresh=true",
      "body": {
        "title": "exact neural match",
        "embedding": [
          3.0,
          1.0,
          3.0
        ]
      },
      "expected_status": 201,
      "compare_paths": [
        "result"
      ],
      "expected_paths": {
        "result": "created"
      }
    },
    {
      "name": "put_neural_doc_b",
      "method": "PUT",
      "path": "/vectors-neural-compat/_doc/doc-b?refresh=true",
      "body": {
        "title": "farther vector",
        "embedding": [
          1.0,
          1.0,
          1.0
        ]
      },
      "expected_status": 201,
      "compare_paths": [
        "result"
      ],
      "expected_paths": {
        "result": "created"
      }
    },
    {
      "name": "put_neural_pipeline",
      "method": "PUT",
      "path": "/_search/pipeline/neural-defaults",
      "body": {
        "description": "neural default model pipeline",
        "request_processors": [
          {
            "neural_query_enricher": {
              "default_model_id": "${get_register_task.model_id}"
            }
          }
        ],
        "response_processors": []
      },
      "expected_status": 200,
      "compare_paths": [
        "acknowledged"
      ],
      "expected_paths": {
        "acknowledged": true
      }
    },
    {
      "name": "neural_query_search",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-dev-target-lifecycle",
      "reason": "Depends on a deployed OpenSearch ML Commons text embedding model; the constrained dev target does not reach stable neural serving for this fixture.",
      "method": "POST",
      "path": "/vectors-neural-compat/_search?search_pipeline=neural-defaults",
      "body": {
        "size": 2,
        "query": {
          "neural": {
            "embedding": {
              "query_text": "aaa",
              "k": 2
            }
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "hits.total.value",
        "hits.hits.0._id"
      ],
      "expected_paths": {
        "hits.total.value": 2,
        "hits.hits.0._id": "doc-a"
      },
      "metadata": {
        "evidence_classes": [
          "neural-query-rewrite"
        ]
      }
    },
    {
      "name": "create_rerank_index",
      "method": "PUT",
      "path": "/logs-rerank-compat",
      "body": {
        "mappings": {
          "properties": {
            "title": {
              "type": "text"
            }
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "acknowledged"
      ],
      "expected_paths": {
        "acknowledged": true
      }
    },
    {
      "name": "put_rerank_doc_a",
      "method": "PUT",
      "path": "/logs-rerank-compat/_doc/doc-a?refresh=true",
      "body": {
        "title": "alpha exact winner"
      },
      "expected_status": 201,
      "compare_paths": [
        "result"
      ],
      "expected_paths": {
        "result": "created"
      }
    },
    {
      "name": "put_rerank_doc_b",
      "method": "PUT",
      "path": "/logs-rerank-compat/_doc/doc-b?refresh=true",
      "body": {
        "title": "beta fallback"
      },
      "expected_status": 201,
      "compare_paths": [
        "result"
      ],
      "expected_paths": {
        "result": "created"
      }
    },
    {
      "name": "put_rerank_pipeline",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-rerank-fixture",
      "reason": "OpenSearch search pipeline rerank requires a model-backed processor shape that is not satisfied by the lightweight Steelsearch fixture.",
      "method": "PUT",
      "path": "/_search/pipeline/rerank-defaults",
      "body": {
        "request_processors": [],
        "response_processors": [
          {
            "rerank": {
              "model_id": "${get_register_task.model_id}",
              "field": "title",
              "query_text": "alpha winner"
            }
          }
        ]
      },
      "expected_status": 200,
      "compare_paths": [
        "acknowledged"
      ],
      "expected_paths": {
        "acknowledged": true
      }
    },
    {
      "name": "rerank_pipeline_search",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-rerank-fixture",
      "reason": "Depends on the rerank pipeline fixture that OpenSearch rejects without a stable deployed rerank-capable model.",
      "method": "POST",
      "path": "/logs-rerank-compat/_search?search_pipeline=rerank-defaults",
      "body": {
        "query": {
          "match_all": {}
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "hits.hits.0._id"
      ],
      "expected_paths": {
        "hits.hits.0._id": "doc-a"
      },
      "metadata": {
        "evidence_classes": [
          "rerank-pipeline"
        ]
      }
    },
    {
      "name": "create_sparse_index",
      "method": "PUT",
      "path": "/logs-sparse-compat",
      "body": {
        "mappings": {
          "properties": {
            "title": {
              "type": "text"
            }
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "acknowledged"
      ],
      "expected_paths": {
        "acknowledged": true
      }
    },
    {
      "name": "put_sparse_doc_a",
      "method": "PUT",
      "path": "/logs-sparse-compat/_doc/doc-a?refresh=true",
      "body": {
        "title": "alpha winner exact"
      },
      "expected_status": 201,
      "compare_paths": [
        "result"
      ],
      "expected_paths": {
        "result": "created"
      }
    },
    {
      "name": "put_sparse_doc_b",
      "method": "PUT",
      "path": "/logs-sparse-compat/_doc/doc-b?refresh=true",
      "body": {
        "title": "beta fallback"
      },
      "expected_status": 201,
      "compare_paths": [
        "result"
      ],
      "expected_paths": {
        "result": "created"
      }
    },
    {
      "name": "sparse_encoder_search",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-sparse-fixture",
      "reason": "Depends on a deployed OpenSearch sparse encoder model; the constrained dev target does not provide stable sparse serving for this fixture.",
      "method": "POST",
      "path": "/logs-sparse-compat/_search",
      "body": {
        "query": {
          "sparse_encoder": {
            "title": {
              "query_text": "alpha",
              "model_id": "${get_register_task.model_id}"
            }
          }
        }
      },
      "expected_status": 200,
      "compare_paths": [
        "hits.total.value",
        "hits.hits.0._id"
      ],
      "expected_paths": {
        "hits.total.value": 1,
        "hits.hits.0._id": "doc-a"
      },
      "metadata": {
        "evidence_classes": [
          "sparse-encoder"
        ]
      }
    },
    {
      "name": "undeploy_model",
      "comparison": "steelsearch_only",
      "expected_steelsearch_status": 200,
      "skip_scope": "opensearch-ml-dev-target-lifecycle",
      "reason": "Depends on a successful OpenSearch ML Commons deploy lifecycle; Steelsearch undeploy readback remains explicit lifecycle evidence.",
      "method": "POST",
      "path": "/_plugins/_ml/models/${get_register_task.model_id}/_undeploy",
      "expected_status": 200,
      "compare_paths": [
        "model_id",
        "deployed",
        "task_state"
      ],
      "expected_paths": {
        "model_id": "${get_register_task.model_id}",
        "deployed": false,
        "task_state": "UNDEPLOYED"
      }
    }
  ]
}
