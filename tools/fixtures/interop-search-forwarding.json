  "cases": [
    {
      "name": "match_all_search",
      "body": {
        "query": {
          "match_all": {}
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 3,
      "expected_ids": [
        "doc-1",
        "doc-2",
        "doc-3"
      ]
    },
    {
      "name": "term_search",
      "body": {
        "query": {
          "term": {
            "service": "api"
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 2,
      "expected_ids": [
        "doc-1",
        "doc-2"
      ]
    },
    {
      "name": "range_search",
      "body": {
        "query": {
          "range": {
            "latency_ms": {
              "gte": 100
            }
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 2,
      "expected_ids": [
        "doc-2",
        "doc-3"
      ]
    },
    {
      "name": "bool_filter_search",
      "body": {
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "service": "api"
                }
              },
              {
                "range": {
                  "latency_ms": {
                    "gte": 200
                  }
                }
              }
            ]
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 1,
      "expected_ids": [
        "doc-2"
      ]
    },
    {
      "name": "pit_lifecycle_search",
      "use_pit": true,
      "body": {
        "query": {
          "term": {
            "service": "api"
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 2,
      "expected_ids": [
        "doc-1",
        "doc-2"
      ]
    },
    {
      "name": "search_after_search",
      "body": {
        "query": {
          "match_all": {}
        },
        "sort": [
          {
            "latency_ms": "asc"
          },
          "_id"
        ],
        "search_after": [
          90,
          "doc-1"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 3,
      "expected_ids": [
        "doc-3",
        "doc-2"
      ]
    },
    {
      "name": "nested_tuple_search",
      "body": {
        "query": {
          "nested": {
            "path": "comments",
            "query": {
              "bool": {
                "filter": [
                  {
                    "term": {
                      "comments.author": "ann"
                    }
                  },
                  {
                    "term": {
                      "comments.text": "green"
                    }
                  }
                ]
              }
            }
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 1,
      "expected_ids": [
        "doc-1"
      ]
    },
    {
      "name": "geo_distance_search",
      "body": {
        "query": {
          "geo_distance": {
            "distance": "20km",
            "location": {
              "lat": 37.7749,
              "lon": -122.4194
            }
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 2,
      "expected_ids": [
        "doc-1",
        "doc-3"
      ]
    },
    {
      "name": "script_score_search",
      "body": {
        "query": {
          "script_score": {
            "query": {
              "match_all": {}
            },
            "script": {
              "source": "doc['latency_ms'].value"
            }
          }
        },
        "sort": [
          "_score",
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 3,
      "expected_ids": [
        "doc-2",
        "doc-3",
        "doc-1"
      ]
    },
    {
      "name": "function_score_search",
      "body": {
        "query": {
          "function_score": {
            "query": {
              "match_all": {}
            },
            "field_value_factor": {
              "field": "latency_ms"
            },
            "boost_mode": "replace"
          }
        },
        "sort": [
          "_score",
          "_id"
        ],
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 3,
      "expected_ids": [
        "doc-2",
        "doc-3",
        "doc-1"
      ]
    },
    {
      "name": "rescore_search",
      "body": {
        "query": {
          "match_all": {}
        },
        "rescore": {
          "window_size": 2,
          "query": {
            "rescore_query": {
              "match": {
                "message": "timeout"
              }
            },
            "query_weight": 1.0,
            "rescore_query_weight": 10.0
          }
        },
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 3,
      "expected_ids": [
        "doc-2",
        "doc-1",
        "doc-3"
      ]
    },
    {
      "name": "collapse_search",
      "body": {
        "query": {
          "match_all": {}
        },
        "sort": [
          {
            "service": {
              "order": "asc"
            }
          }
        ],
        "collapse": {
          "field": "service"
        },
        "size": 10,
        "track_total_hits": true
      },
      "expected_total": 3,
      "expected_ids": [
        "doc-1",
        "doc-3"
      ]
    },
    {
      "name": "terms_aggregation_search",
      "body": {
        "query": {
          "match_all": {}
        },
        "size": 0,
        "track_total_hits": true,
        "aggs": {
          "by_service": {
            "terms": {
              "field": "service"
            }
          }
        }
      },
      "expected_total": 3,
      "expected_ids": [],
      "expected_values": {
        "aggregations.by_service.buckets.0.key": "api",
        "aggregations.by_service.buckets.0.doc_count": 2,
        "aggregations.by_service.buckets.1.key": "worker",
        "aggregations.by_service.buckets.1.doc_count": 1
      }
    },
    {
      "name": "highlight_search",
      "body": {
        "query": {
          "match": {
            "message": "timeout"
          }
        },
        "sort": [
          "_id"
        ],
        "size": 10,
        "track_total_hits": true,
        "highlight": {
          "fields": {
            "message": {}
          }
        }
      },
      "expected_total": 2,
      "expected_ids": [
        "doc-2",
        "doc-3"
      ],
      "expected_values": {
        "hits.hits.0.highlight.message.0": "checkout <em>timeout</em>",
        "hits.hits.1.highlight.message.0": "worker <em>timeout</em>"
      }
    },
    {
      "name": "term_suggest_search",
      "body": {
        "suggest": {
          "message-suggest": {
            "text": "chekout",
            "term": {
              "field": "message"
            }
          }
        },
